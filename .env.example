# Copy this file to .env and fill in the values.

# Postgres (Neon / Vercel Postgres / Supabase / …).
# DATABASE_URL = pooled (runtime); DATABASE_URL_UNPOOLED = direct (db push).
# If you only have one URL, put it in both.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Public origin of the site (used for Stripe redirect URLs and links).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Vercel Blob token — needed to upload product photos from /admin.
# Vercel: Storage > Create > Blob, connect to the project, copy from ".env.local".
BLOB_READ_WRITE_TOKEN=""

# Stripe TEST keys from https://dashboard.stripe.com/test/apikeys
# Leave blank to run checkout in DEMO mode (no real payment).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Password for the /admin dashboard. Change this.
ADMIN_PASSWORD="changeme"

# Store currency, ISO 4217 lowercase.
STORE_CURRENCY="cad"
