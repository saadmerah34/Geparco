# Copy this file to .env and fill in the values.

# Postgres connection string (Neon / Vercel Postgres / Supabase / …).
# Use the direct (unpooled) string so `prisma db push` works.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Public origin of the site (used for Stripe redirect URLs and links).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe TEST keys from https://dashboard.stripe.com/test/apikeys
# Leave blank to run checkout in DEMO mode (no real payment).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Password for the /admin dashboard. Change this.
ADMIN_PASSWORD="changeme"

# Store currency, ISO 4217 lowercase.
STORE_CURRENCY="cad"
